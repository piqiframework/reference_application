{
  "ApiDefinition": {
    "Title": "Open Source PIQI Web Services - Test",
    "Version": "v1",
    "Description": "Test environment for PIQI Web Services",
    "Contact": {
      "Name": "PIQI Framework",
      "Url": "https://piqiframework.org/"
    },
    "License": {
      "Name": "<NEEDINFO>",
      "Url": "<NEEDINFO>"
    }
  },
  "Database": {
    "Type": "SQLite"
  },
  "ConnectionStrings": {
    "PIQIDatabase": "Data Source=PIQITest.db"
  },
  "Authentication": {
    "Authority": "https://test-authority.example.com",
    "Audience": "PIQI_API_TEST"
  },
  "CqlService": {
    "BaseUrl": "http://localhost:5100"
  },
  "CustomSwaggerUI": {
    "CSSPath": "../swagger/custom.css",
    "DocTitle": "PIQI Web Services - Test",
    "JSPath": "../swagger/custom.js",
    "SwaggerEndpoint": "v1/swagger.json"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/test-log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "Application": "PIQI-Test"
    }
  },
  "FilePaths": {
    "CodeSystemsPath": "ReferenceData/CodeSystems.json",
    "DataTypesPath": "ReferenceData/DataTypes.json",
    "EntitiesPath": "ReferenceData/Entities.json",
    "EvaluationPath": "TestData/Evaluations/EvaluationProfileLibrary.json",
    "ModelPath": "ReferenceData/Models/ModelLibrary.json",
    "CQLPath": "TestData/CQLTestData/CQL/CQLProfileLibrary.json",
    "SAMsPath": "ReferenceData/SAMs.json",
    "ValueListPath": "ReferenceData/Values.json",
    "ValueSetListPath": "ReferenceData/ContentSets/ValueSets.json",
    "PluginFolder": "Plugins"
  },
  "Fhir": {
    "BaseUrl": "https://symedicaldds.clinicalarchitecture.com/SymedicalSYMEDICALDDSFHIRServices/R4/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
