# Java CQL sidecar (Spring Boot). Build context: repo root.
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY JavaSidecar/pom.xml .
COPY JavaSidecar/src ./src
RUN mvn -q -B package -DskipTests

FROM eclipse-temurin:17-jre
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /build/target/cql-sidecar-1.0.0.jar ./cql-sidecar.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/cql-sidecar.jar"]
