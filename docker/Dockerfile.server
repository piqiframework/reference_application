# PIQI Engine web service (PIQI_Engine.Server). Build context: repo root.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
# The repo's NuGet.Config lists a private Clinical Architecture feed; use nuget.org only.
# ErrorOnDuplicatePublishOutputFiles=false: the server references CQL.Service (also a Web
# project), so both publish an appsettings.json. The server's own copy is re-applied below.
RUN dotnet publish PIQI_Engine.Server/PIQI_Engine.Server.csproj -c Release -o /app/publish \
    --configfile docker/nuget.docker.config \
    -p:ErrorOnDuplicatePublishOutputFiles=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
# Not included by `dotnet publish`: the .cql files, the SQLite DB, and the server's settings.
COPY PIQI_Engine.Server/ReferenceData ./ReferenceData
COPY PIQI_Engine.Server/PIQI.db ./PIQI.db
COPY PIQI_Engine.Server/appsettings.json ./appsettings.json
RUN mkdir -p Logs && chown -R $APP_UID /app
USER $APP_UID
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "PIQI_Engine.Server.dll"]
